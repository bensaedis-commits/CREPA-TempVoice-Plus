# ============================================
# CREPA Temp Voice - Plus Clone
# ============================================
# Copy this file to .env and fill your data

# Bot token from Discord Developer Portal
DISCORD_TOKEN=YOUR_BOT_TOKEN_HERE

# Bot Client ID from Developer Portal -> Application -> General Information
CLIENT_ID=YOUR_CLIENT_ID_HERE

# Optional: Guild ID for instant command deploy (global takes up to 1 hour)
# Leave empty for global commands
GUILD_ID=

# ============================================
# Optional
# ============================================
# LOG_LEVEL=info
